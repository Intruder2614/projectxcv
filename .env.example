# Defaults are local-only. Keep HOST on 127.0.0.1 unless you have added authentication and hardened deployment controls.
HOST=127.0.0.1
PORT=8000
# Optional: set a PostgreSQL URL for a staging deployment. SQLite is used by default.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/codingal_studio
# Optional: Docker image used by the local isolated runner.
CODESTUDIO_RUNNER_IMAGE=codingal-runner:local
# Optional: choose a separate data location.
# CODESTUDIO_DATA_DIR=/absolute/path/to/codingal-studio-data
